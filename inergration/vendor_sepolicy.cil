
(type penbridge)
(type penbridge_exec)
(typeattributeset domain (penbridge))
(typeattributeset exec_type (penbridge_exec))
(typeattributeset file_type (penbridge_exec))
(typeattributeset vendor_file_type (penbridge_exec))
(roletype object_r penbridge_exec)
(allow init penbridge_exec (file (open read getattr execute map)))
(allow init penbridge (process (transition siginh rlimitinh)))
(allow penbridge penbridge_exec (file (entrypoint open read getattr execute map)))
(allow penbridge self (process (fork sigchld)))
(allow penbridge self (capability (dac_override dac_read_search)))
(allow penbridge input_device (dir (search read)))
(allow penbridge input_device (chr_file (open read getattr ioctl)))
(allow penbridge uinput_device (chr_file (open write getattr ioctl)))
(allow penbridge self (unix_stream_socket (create connect write read getattr)))
(allow penbridge logd (unix_stream_socket (connectto)))
(allow penbridge logdw_socket (sock_file (write open)))
